{
  "cleanupPeriodDays": 14,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "multi-agent-starter@multi-agent-starter": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "multi-agent-starter": {
      "source": {
        "source": "github",
        "repo": "netwaif/multi-agent-starter"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "full",
    "PONYTAIL_SUBAGENT_MATCHER": "^(claude-main|general-purpose|deep-reasoner|runner|explore|plan)$"
  },
  "theme": "dark",
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/check-config-updates.sh",
            "timeout": 15,
            "statusMessage": "Checking for config updates…"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-sound.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-sound.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "allow": [
      "Bash(apt list *)",
      "Bash(apt policy *)",
      "Bash(apt show *)",
      "Bash(apt-cache *)",
      "Bash(cat *)",
      "Bash(conda config --show*)",
      "Bash(conda env list*)",
      "Bash(conda info*)",
      "Bash(conda list*)",
      "Bash(date*)",
      "Bash(df *)",
      "Bash(dpkg -L *)",
      "Bash(dpkg -l*)",
      "Bash(dpkg -s *)",
      "Bash(dpkg-query *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(flatpak info *)",
      "Bash(flatpak list*)",
      "Bash(flatpak remotes*)",
      "Bash(flatpak search *)",
      "Bash(free *)",
      "Bash(git branch)",
      "Bash(git config --get *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status*)",
      "Bash(gpg --fingerprint*)",
      "Bash(gpg --list-keys*)",
      "Bash(gpg --show-keys *)",
      "Bash(grep *)",
      "Bash(gsettings describe *)",
      "Bash(gsettings get *)",
      "Bash(gsettings list-*)",
      "Bash(gsettings range *)",
      "Bash(head *)",
      "Bash(hostnamectl*)",
      "Bash(id)",
      "Bash(journalctl *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(lsblk *)",
      "Bash(lscpu*)",
      "Bash(lspci *)",
      "Bash(lsusb *)",
      "Bash(md5sum *)",
      "Bash(nvidia-smi*)",
      "Bash(printf *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(sha256sum *)",
      "Bash(snap info *)",
      "Bash(snap list*)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(systemctl cat *)",
      "Bash(systemctl is-active *)",
      "Bash(systemctl is-enabled *)",
      "Bash(systemctl list-unit-files*)",
      "Bash(systemctl list-units*)",
      "Bash(systemctl show *)",
      "Bash(systemctl status *)",
      "Bash(tail *)",
      "Bash(uname *)",
      "Bash(uniq *)",
      "Bash(uptime*)",
      "Bash(wc *)",
      "Bash(whereis *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Read"
    ],
    "deny": [
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.netrc)",
      "Edit(**/credentials.json)",
      "Edit(//**/*.env)",
      "Edit(//**/*.kdbx)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.pfx)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/.git-credentials)",
      "Edit(//**/.netrc)",
      "Edit(//**/.npmrc)",
      "Edit(//**/.pypirc)",
      "Edit(//**/credentials.json)",
      "Edit(//**/id_dsa)",
      "Edit(//**/id_ecdsa)",
      "Edit(//**/id_ed25519)",
      "Edit(//**/id_rsa)",
      "Edit(//home/jaeukk/.aws/**)",
      "Edit(//home/jaeukk/.claude/.credentials.json)",
      "Edit(//home/jaeukk/.config/ai-cli/**)",
      "Edit(//home/jaeukk/.config/gh/**)",
      "Edit(//home/jaeukk/.config/rclone/**)",
      "Edit(//home/jaeukk/.docker/config.json)",
      "Edit(//home/jaeukk/.gnupg/**)",
      "Edit(//home/jaeukk/.kube/**)",
      "Edit(//home/jaeukk/.password-store/**)",
      "Edit(//home/jaeukk/.ssh/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.netrc)",
      "Read(**/credentials.json)",
      "Read(//**/*.env)",
      "Read(//**/*.kdbx)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pem)",
      "Read(//**/*.pfx)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.git-credentials)",
      "Read(//**/.netrc)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Read(//**/credentials.json)",
      "Read(//**/id_dsa)",
      "Read(//**/id_ecdsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_rsa)",
      "Read(//home/jaeukk/.aws/**)",
      "Read(//home/jaeukk/.claude/.credentials.json)",
      "Read(//home/jaeukk/.config/ai-cli/**)",
      "Read(//home/jaeukk/.config/gh/**)",
      "Read(//home/jaeukk/.config/rclone/**)",
      "Read(//home/jaeukk/.docker/config.json)",
      "Read(//home/jaeukk/.gnupg/**)",
      "Read(//home/jaeukk/.kube/**)",
      "Read(//home/jaeukk/.password-store/**)",
      "Read(//home/jaeukk/.ssh/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
