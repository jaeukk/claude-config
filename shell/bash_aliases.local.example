# Copy to ~/.bash_aliases.local and adjust for this machine. Do not commit that local file.

# BACKUP_WINDOWS_DRIVE is read on WSL only; native Linux finds the volume by label.
BACKUP_WINDOWS_DRIVE="D:"
BACKUP_VOLUME_LABEL="Backup2"
# WSL: a drvfs mount point such as /mnt/backup2.
# Native Linux: where udisks mounts it, i.e. /run/media/$USER/<label>.
BACKUP_MOUNT_POINT="/mnt/backup2"
BACKUP_RETENTION_DAYS=30

SYNC_DIRS=(
    "10_Projects/10_Active/Plasmon"
    "10_Projects/10_Active/multi-stealthy"
)
RSYNC_DST="${HOME}"
CODES_EXCLUDES=(
    --exclude=Julia/
    --exclude=99_installs/
    --exclude=MATLAB/
    --exclude=meep/
    --exclude=obsolate/
)
